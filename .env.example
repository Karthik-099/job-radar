# Copy to .env in the repo root for local runs:  cp .env.example .env && chmod 600 .env
# Never commit .env (it is git-ignored and blocked by the pre-commit hook).
# In GitHub Actions the same names come from: repo Settings > Secrets and variables > Actions.

# AI scoring (Phase 3). Free, no card.
GROQ_API_KEY=          # console.groq.com > API Keys
GEMINI_API_KEY=        # aistudio.google.com/apikey
OPENROUTER_API_KEY=    # openrouter.ai > Keys. Set the key's credit limit to 0: only ":free" models are ever used

# Dashboard (Phase 4)
DASHBOARD_PASSWORD=    # long passphrase, 5+ random words
DASHBOARD_REPO_TOKEN=  # fine-grained token, Contents: read/write on job-radar-dashboard only

# Gmail sync (Phase 5), read-only scope
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
